# No API key or account is required for occasional book searches.
# Optional: set a contact email locally for regular Open Library use.
# This value is sent to Open Library in the server's User-Agent header.
OPEN_LIBRARY_CONTACT_EMAIL=

# Clerk development keys: copy this file to ignored .env.local and fill these
# two empty values. Never put real credentials in this example file.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase PostgreSQL. Keep both values server-only.
# DATABASE_URL uses the transaction pooler (port 6543) for deployed app traffic.
# DIRECT_URL uses the session pooler (port 5432), or a direct connection when
# IPv6 is available, for Prisma migrations.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres"
